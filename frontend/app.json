{
  "expo": {
    "name": "HoopPlan",
    "slug": "hoopplan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hoopplan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hoopplan.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.hoopplan.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF7A1A"
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "HoopPlan uses the microphone so you can talk to your AI basketball coach during workouts."
        }
      ]
    ],
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#FF7A1A"
    },
    "extra": {
      "eas": {
        "projectId": "2b536ebc-e798-403b-bc5c-26d472cbaa4f"
      }
    }
  }
}
