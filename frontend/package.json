{
  "name": "hoopplan",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:dev:android": "npx eas-cli build --profile development --platform android",
    "build:dev:ios": "npx eas-cli build --profile development --platform ios",
    "build:staging:android": "npx eas-cli build --profile staging --platform android",
    "build:staging:ios": "npx eas-cli build --profile staging --platform ios",
    "build:testflight:ios": "npx eas-cli build --profile testflight --platform ios",
    "submit:testflight": "npx eas-cli submit --platform ios --latest --profile testflight",
    "build:production:ios": "npx eas-cli build --profile production --platform ios",
    "submit:production": "npx eas-cli submit --platform ios --latest --profile production",
    "update:staging": "npx eas-cli update --channel staging --environment preview",
    "update:production": "npx eas-cli update --channel production --environment production",
    "promote:production": "npx eas-cli update:republish --destination-channel production",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.1",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~57.0.4",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.0",
    "expo-config-plugin-incall-manager": "^1.0.0",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.5",
    "expo-device": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-keep-awake": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.4",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-store-review": "~57.0.1",
    "expo-system-ui": "~57.0.0",
    "expo-updates": "~57.0.6",
    "expo-web-browser": "~57.0.0",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-incall-manager": "^4.2.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "^15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-incall-manager",
          "react-native-webrtc"
        ]
      }
    }
  }
}
